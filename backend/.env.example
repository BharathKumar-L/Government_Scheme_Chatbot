# Environment: development or production
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# ============================================
# MongoDB Atlas Configuration (PRODUCTION)
# ============================================
# 1. Create MongoDB Atlas Cluster: https://www.mongodb.com/cloud/atlas
# 2. Create database user and get connection string
# 3. Format: mongodb+srv://username:password@cluster-name.mongodb.net/database-name?retryWrites=true&w=majority
# 4. NOTE: URL-encode special characters in password (e.g., @ => %40, / => %2F)
MONGODB_URI=mongodb+srv://username:password@cluster-name.mongodb.net/schemes?retryWrites=true&w=majority
DATABASE_TYPE=mongodb

# ============================================
# Admin Credentials
# ============================================
# Change these credentials for production!
ADMIN_EMAIL=admin@ruralconnect.com
ADMIN_PASSWORD=admin123

# ============================================
# LLM Configuration
# ============================================
# Choose one LLM backend
USE_HUGGINGFACE=true
USE_OLLAMA=false
USE_LOCAL_LLM=false

# HuggingFace Configuration
HF_API_TOKEN=your_huggingface_api_token

# Ollama Configuration (if using local Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# ============================================
# Translation Service
# ============================================
# Use 'local' for rule-based translation or 'google' for Google Translate API
TRANSLATION_SERVICE=local

# ============================================
# Logging
# ============================================
LOG_LEVEL=info

# ============================================
# File Upload Configuration
# ============================================
MAX_FILE_SIZE=50mb
UPLOAD_DIR=./uploads

# ============================================
# Rate Limiting
# ============================================
# Time window in milliseconds (900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per window
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# Dataset Configuration
# ============================================
# Path to the CSV file with government schemes
DATASET_PATH=../Datasets/updated_data.csv
